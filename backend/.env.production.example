# =============================================================================
# Dinkes Kaltara — Backend production .env (aaPanel / shared hosting)
# Copy to `.env`, fill the CHANGE_ME values, then run:
#   php artisan key:generate
#   php artisan jwt:secret
# =============================================================================

APP_NAME="Dinkes Kaltara"
APP_ENV=production
APP_KEY=                       # generated by: php artisan key:generate
APP_DEBUG=false
APP_URL=https://DOMAIN_ANDA.go.id
APP_TIMEZONE=Asia/Makassar     # WITA (Kalimantan Utara)

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Logging — keep 'error' in production so logs don't balloon on shared disk
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ---------------------------------------------------------------------------
# Database — create this MySQL DB + user in aaPanel first (Databases > Add)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME_dbname
DB_USERNAME=CHANGE_ME_dbuser
DB_PASSWORD=CHANGE_ME_dbpass

# ---------------------------------------------------------------------------
# Sessions / cache / queue — no external services, no worker/cron needed
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true      # requires HTTPS (enable after SSL is active)
SESSION_SAME_SITE=lax
# SESSION_DOMAIN=DOMAIN_ANDA.go.id

CACHE_STORE=database
QUEUE_CONNECTION=sync           # jobs run inline; no queue worker required
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# Mail — OPTIONAL. The contact inbox stores messages in the DB and works
# without mail. Configure SMTP only if you later add email notifications.
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@DOMAIN_ANDA.go.id"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Auth (JWT)
# ---------------------------------------------------------------------------
JWT_SECRET=                     # generated by: php artisan jwt:secret
JWT_TTL=1440

# ---------------------------------------------------------------------------
# Frontend origin — used ONLY for CORS if you host the SPA on a different
# origin (e.g. a subdomain). For the recommended single-domain deploy, set it
# to the same site URL.
# ---------------------------------------------------------------------------
FRONTEND_URL=https://DOMAIN_ANDA.go.id

# ---------------------------------------------------------------------------
# Google reCAPTCHA v2 — protects admin login + public contact form.
# Set RECAPTCHA_SECRET to ENFORCE verification. Leave it BLANK to disable
# (login + contact form still work without a captcha).
# Get keys at: https://www.google.com/recaptcha/admin  (type: reCAPTCHA v2
# "I'm not a robot" checkbox). Add your domain to the allowed domains list.
# ---------------------------------------------------------------------------
RECAPTCHA_SECRET=
BYPASS_RECAPTCHA=false

# ---------------------------------------------------------------------------
# SSO Portal Kaltara (opsional) — login admin lewat portal.kaltaraprov.go.id.
# Aktif otomatis bila APPLICATION_ID dan API_KEY terisi; login username/
# password tetap tersedia. Minta admin portal mendaftarkan aplikasi dengan
#   Callback URL : https://DOMAIN_ANDA.go.id/sso/callback
#   Alur SSO     : code
# API key hanya disimpan di sini (server), jangan di frontend atau Git.
# ---------------------------------------------------------------------------
SSO_PORTAL_URL=https://portal.kaltaraprov.go.id
SSO_PORTAL_APPLICATION_ID=
SSO_PORTAL_API_KEY=
# Realm yang boleh masuk panel admin (koma). Bawaan: hanya ASN.
SSO_PORTAL_REALM=asn-kaltara
# Kode role portal -> peran situs, mis. "operator:editor,pimpinan:admin".
# Kosong = kode role yang sama dengan nama peran (admin, editor, kontributor)
# dipakai apa adanya. super_admin hanya bila dipetakan di sini.
SSO_PORTAL_PETA_PERAN=
