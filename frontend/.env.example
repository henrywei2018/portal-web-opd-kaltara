# Frontend config (Vite membakukan nilai ini saat BUILD — rebuild setelah diubah).
# Salin ke `.env` untuk development: `cp .env.example .env`

# Base URL API. Development: backend Laravel di localhost:8000.
# Production (single-domain): gunakan path relatif `/api` (lihat .env.production).
VITE_API_BASE_URL=http://localhost:8000/api

# Google reCAPTCHA v2 — SITE key (PUBLIC). Kosongkan jika captcha tidak dipakai.
VITE_RECAPTCHA_SITE_KEY=

# 'true' untuk mewajibkan reCAPTCHA (butuh SITE key di atas + RECAPTCHA_SECRET di backend .env).
# Biarkan 'false' untuk development tanpa captcha.
VITE_REQUIRE_RECAPTCHA=false
