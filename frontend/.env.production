# Frontend production build config (Vite bakes these in at BUILD time —
# rebuild after any change: `npm run build`).

# Same-domain deploy: the API is served by Laravel under /api on the same
# origin, so a relative path avoids all CORS. (Use a full URL like
# https://api.domain.go.id/api only if you split the SPA to another origin.)
VITE_API_BASE_URL=/api

# Google reCAPTCHA v2 site key (the PUBLIC key). Fill this AND set
# VITE_REQUIRE_RECAPTCHA=true to show the captcha on login + contact form.
# The matching RECAPTCHA_SECRET must be set in the backend .env.
VITE_RECAPTCHA_SITE_KEY=6LcxWlwtAAAAAJIDVQA0fGz4FKIoBzhWxq2ItAmG

# Set to "true" to require reCAPTCHA. Keep "false" to deploy without it first
# (you can enable it later — just rebuild the frontend).
VITE_REQUIRE_RECAPTCHA=true
